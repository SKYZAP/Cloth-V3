# Trust the OS certificate store in every npm script and install step (electron's postinstall, electron-builder,
# sidecar downloads): antivirus and corporate proxies re-sign HTTPS with a root only the OS store has.
# Needs Node 22.15 or later (see engines in package.json). scripts/system-ca.mjs covers `node scripts/…` runs.
node-options=--use-system-ca
