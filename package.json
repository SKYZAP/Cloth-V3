{
  "name": "cloth",
  "productName": "Cloth",
  "version": "0.1.0",
  "description": "Cloth — an offline developer hub: providers, agent chat, hybrid RAG, skills, workflows and an MCP server.",
  "type": "module",
  "main": "out/main/index.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "npm run sidecars && electron-vite build && electron-builder --dir",
    "dist": "npm run sidecars && electron-vite build && electron-builder",
    "mock-llm": "node scripts/mock-llm.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "sidecars": "node scripts/stage-obscura.mjs && node scripts/stage-searxng.mjs"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@mozilla/readability": "^0.6.0",
    "croner": "^10.0.1",
    "linkedom": "^0.18.13",
    "mammoth": "^1.12.3",
    "turndown": "^7.2.4",
    "typebox": "^1.3.34",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "cronstrue": "^3.27.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  },
  "author": "Cloth",
  "build": {
    "appId": "dev.cloth.app",
    "productName": "Cloth",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "icon": "resources/icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Cloth-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "sidecars/obscura",
        "to": "obscura",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sidecars/searxng",
        "to": "searxng",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/examples",
        "to": "examples",
        "filter": [
          "**/*.md"
        ]
      }
    ]
  }
}
