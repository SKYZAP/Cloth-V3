{
  "name": "cloth",
  "productName": "Cloth",
  "version": "1.2.0",
  "description": "Cloth — an offline developer hub: providers, agent chat, hybrid RAG, skills, workflows and an MCP server.",
  "type": "module",
  "main": "out/main/index.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "npm run sidecars && npm run build:runner && electron-vite build && electron-builder --dir",
    "dist": "npm run sidecars && npm run build:runner && electron-vite build && electron-builder --publish never",
    "release": "node scripts/release.mjs",
    "mock-llm": "node scripts/mock-llm.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "sidecars": "node scripts/stage-obscura.mjs && node scripts/stage-searxng.mjs",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "mobile:apk": "node scripts/mobile-apk.mjs debug",
    "mobile:release": "node scripts/mobile-apk.mjs release",
    "build:runner": "node scripts/build-runner.mjs"
  },
  "dependencies": {
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/napi": "^0.45.3",
    "@earendil-works/pi-agent-core": "^0.87.1",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@mozilla/readability": "^0.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "croner": "^10.0.1",
    "diff": "^8.0.4",
    "docx": "^9.8.1",
    "electron-updater": "^6.8.11",
    "ignore": "^7.0.8",
    "koffi": "3.3.1",
    "linkedom": "^0.18.13",
    "mammoth": "^1.12.3",
    "pele": "1.9.0",
    "postcss": "^8.5.28",
    "pptxgenjs": "^4.0.1",
    "pyright": "^1.1.414",
    "turndown": "^7.2.4",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "undici": "^7.30.0",
    "unpdf": "^1.8.1",
    "vscode-jsonrpc": "^9.0.3",
    "vscode-languageserver-protocol": "^3.18.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "cronstrue": "^3.27.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  },
  "author": "Cloth",
  "build": {
    "appId": "dev.cloth.app",
    "publish": [
      {
        "provider": "github",
        "owner": "SKYZAP",
        "repo": "Cloth-V3",
        "private": true,
        "releaseType": "draft"
      }
    ],
    "productName": "Cloth",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "package.json",
      "resources/icon.png",
      "!**/*.map",
      "!out/runner/**"
    ],
    "asar": true,
    "icon": "resources/icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Cloth-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "build/runner-dist/win-unpacked",
          "to": "flow-runner",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "build/nsis",
          "to": "nsis",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "Cloth-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "sidecars/obscura",
        "to": "obscura",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sidecars/searxng",
        "to": "searxng",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/examples",
        "to": "examples",
        "filter": [
          "**/*.md"
        ]
      },
      {
        "from": "node_modules/@typescript/typescript-${platform}-${arch}",
        "to": "typescript",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/@ast-grep/**",
      "node_modules/@lydell/**",
      "node_modules/pyright/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ]
  }
}
